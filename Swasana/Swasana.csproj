<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Swasana</RootNamespace>
    <Version>1.3.3</Version>
    <Product>SWASANA</Product>
    <ApplicationIcon>swasana.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentTransitions" Version="2.0.9" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <!-- Skema database ikut tertanam di .exe supaya aplikasi bisa menyiapkan database sendiri -->
  <ItemGroup>
    <EmbeddedResource Include="..\database\swasana_schema.sql" LogicalName="swasana_schema.sql" />
    <EmbeddedResource Include="Ikon\*.png" LogicalName="Ikon.%(Filename).png" />
    <EmbeddedResource Include="swasana.ico" LogicalName="swasana.ico" />
    <EmbeddedResource Include="IkonAnimasi\*.png" LogicalName="Animasi.%(Filename).png" />
    <!-- Koneksi database bawaan (Supabase). File ini di-ignore git karena berisi password; kalau tidak ada,
         aplikasi meminta pengaturan koneksi seperti biasa. -->
    <EmbeddedResource Include="koneksi-bawaan.txt" LogicalName="koneksi-bawaan.txt" Condition="Exists('koneksi-bawaan.txt')" />
  </ItemGroup>

</Project>
