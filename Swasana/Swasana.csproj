<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Swasana</RootNamespace>
    <Version>1.0.0</Version>
    <Product>SWASANA</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <!-- Skema database ikut tertanam di .exe supaya aplikasi bisa menyiapkan database sendiri -->
  <ItemGroup>
    <EmbeddedResource Include="..\database\swasana_schema.sql" LogicalName="swasana_schema.sql" />
  </ItemGroup>

</Project>
